---
import { withBase } from "../lib/paths";
import { book } from "../data/book";
---

<footer class="site-footer">
  <div>
    <strong>{book.title}</strong>
    <p>{book.author} · {book.publisher} · Primera edición, {book.published.toLowerCase()}</p>
    <p>
      <a href={'mailto:' + book.contact.email}>{book.contact.email}</a>
      · <a href={book.contact.x} target="_blank" rel="me noopener noreferrer">X / Twitter</a>
      · <a href={book.contact.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn</a>
    </p>
  </div>
  <nav aria-label="Enlaces del pie">
    <a href={book.doi}>DOI</a>
    <a href={book.officialPage}>Ficha editorial</a>
    <a href={withBase("/referencias/")}>Referencias</a>
    <a href={withBase("/buscar/")}>Buscar</a>
  </nav>
  <p class="rights">{book.copyright}</p>
</footer>
