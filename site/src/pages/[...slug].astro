---
import { getCollection, render } from "astro:content";
import ReaderLayout from "../layouts/ReaderLayout.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("chapters")).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, index) => ({
    params: { slug: entry.data.slug },
    props: {
      entry,
      previous: index > 0 ? { slug: entries[index - 1].data.slug, label: entries[index - 1].data.title } : undefined,
      next: index < entries.length - 1 ? { slug: entries[index + 1].data.slug, label: entries[index + 1].data.title } : undefined,
    },
  }));
}

const { entry, previous, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<ReaderLayout
  title={entry.data.title}
  shortTitle={entry.data.shortTitle}
  description={entry.data.description}
  chapterNumber={entry.data.chapterNumber}
  author={entry.data.author}
  headings={headings}
  previous={previous}
  next={next}
>
  <Content />
</ReaderLayout>

